  "capabilities": [
    {
      "id": "adaptive-orchestrate",
      "type": "skill",
      "providers": [
        "anthropic",
        "openai"
      ],
      "enabled": true,
      "description": "Root task decomposition and routing workflow installed by aorch.",
      "trustTier": "trusted"
    },
    {
      "id": "test-driven-development",
      "type": "skill",
      "providers": [
        "anthropic",
        "openai"
      ],
      "enabled": false,
      "trustTier": "trusted"
    },
    {
      "id": "systematic-debugging",
      "type": "skill",
      "providers": [
        "anthropic",
        "openai"
      ],
      "enabled": false,
      "trustTier": "trusted"
    },
    {
      "id": "verification-before-completion",
      "type": "skill",
      "providers": [
        "anthropic",
        "openai"
      ],
      "enabled": false,
      "trustTier": "trusted"
    },
    {
      "id": "browser-qa",
      "type": "plugin",
      "providers": [
        "anthropic",
        "openai"
      ],
      "enabled": false,
      "trustTier": "reviewed"
    },
    {
      "id": "official-docs",
      "type": "plugin",
      "providers": [
        "anthropic",
        "openai"
      ],
      "enabled": false,
      "trustTier": "reviewed"
    },
    {
      "id": "quality-gate",
      "type": "hook",
      "providers": [
        "*"
      ],
      "enabled": false,
      "phase": "post",
      "trustTier": "trusted"
    }
  ],
  "progress": {
    "intervalMinutes": 30
  },
  "paths": {
    "stateDir": ".aorch",
    "observationsFile": ".aorch/observations.jsonl"
  },
  "verification": {
    "commandTimeoutMs": 900000,
    "isolationByRisk": {
      "low": "same-workspace",
      "standard": "git-worktree",
      "high": "git-worktree",
      "critical": "git-worktree"
    },
    "totalTimeoutMs": 1800000,
    "maxOutputBytes": 8388608,
    "maxChecks": 20
  },
  "controlPlane": {
    "providerTrustByRisk": {
      "low": [
        "trusted",
        "reviewed",
        "untrusted"
      ],
      "standard": [
        "trusted",
        "reviewed"
      ],
      "high": [
        "trusted",
        "reviewed"
      ],
      "critical": [
        "trusted"
      ]
    },
    "capabilityTrustByRisk": {
      "low": [
        "trusted",
        "reviewed",
        "untrusted"
      ],
      "standard": [
        "trusted",
        "reviewed"
      ],
      "high": [
        "trusted",
        "reviewed"
      ],
      "critical": [
        "trusted"
      ]
    },
    "experimentalAdapterMaxRisk": "standard",
    "protectedFiles": [
      ".aorch/config.json",
      ".aorch/hooks/gate.mjs",
      ".aorch/hooks/user-prompt-submit.mjs",
      ".aorch/hooks/session-review.mjs",
      ".claude/settings.json",
      ".codex/hooks.json",
      ".claude/skills/adaptive-orchestrate/SKILL.md",
      ".claude/skills/post-run-reflection/SKILL.md",
      ".agents/skills/adaptive-orchestrate/SKILL.md",
      ".agents/skills/post-run-reflection/SKILL.md"
    ]
  },
  "hostPolicy": {
    "selectionMode": "preferred",
    "routerEscalationThreshold": 6,
    "executionMode": "bootstrap-only",
    "allowHostProductEdits": false
  },
  "lanePolicy": {
    "single-worker": {
      "maxTasks": 1,
      "maxExternalModelCalls": 1,
      "maxLlmReviewers": 0
    },
    "bundled": {
      "maxTasks": 2,
      "maxExternalModelCalls": 1,
      "maxLlmReviewers": 0
    },
    "orchestrated": {
      "maxTasks": 24,
      "maxExternalModelCalls": 12,
      "maxLlmReviewers": 3
    }
  },
  "shadowRouting": {
    "mode": "record-only",
    "execute": false
  },
  "promptCompilation": {
    "maxChars": 40000,
    "officialSourcesOnly": true,
    "maxProfileAgeDays": 120,
    "maxFutureSkewDays": 1
  },
  "execution": {
    "workerTimeoutMs": 3600000,
    "killGraceMs": 1000,
    "maxOutputBytes": 10485760,
    "maxReceiptBytes": 2097152
  },
  "orchestration": {
    "maxTasksPerRun": 24
  }
}
