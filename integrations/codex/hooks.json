{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{AORCH_PROJECT}}/.aorch/hooks/subagent-gate.mjs\" openai",
            "timeout": 10,
            "statusMessage": "Recommending a native subagent route (advisory)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{AORCH_PROJECT}}/.aorch/hooks/user-prompt-submit.mjs\"",
            "timeout": 3,
            "statusMessage": "Classifying adaptive orchestration policy"
          }
        ]
      }
    ]
  }
}
