{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$ROOT/.aorch/hooks/user-prompt-submit.mjs\"",
            "timeout": 3,
            "statusMessage": "Classifying adaptive orchestration policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; node \"$ROOT/.aorch/hooks/session-review.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking post-run reflection"
          }
        ]
      }
    ]
  }
}
