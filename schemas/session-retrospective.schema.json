{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Orchestrator Session Retrospective Input",
  "type": "object",
  "required": [
    "outcome",
    "summary",
    "whatWorked",
    "errors",
    "inefficiencies",
    "technicalDebt",
    "proposals"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Optional when the target run is already selected by CLI; if present it must match that run."
    },
    "outcome": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "whatWorked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "evidence",
          "prevention",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "prevention": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "inefficiencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "evidence",
          "proposedChange"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proposedChange": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "technicalDebt": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "scope",
          "introducedByRun",
          "recommendedAction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "harness",
              "project"
            ]
          },
          "introducedByRun": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pending",
              "resolved"
            ]
          },
          "resolutionEvidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommendedAction": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "rationale",
          "expectedBenefit",
          "risks",
          "affectedFiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "error-prevention",
              "efficiency",
              "technical-debt",
              "routing",
              "capability",
              "documentation"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "expectedBenefit": {
            "type": "string",
            "minLength": 1
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "affectedFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
