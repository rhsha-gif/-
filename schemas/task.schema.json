{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "standard",
        "high",
        "critical"
      ]
    },
    "write": {
      "type": "boolean"
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "capabilityIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbiddenScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verificationCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routingPriorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "quality",
          "tokens",
          "latency"
        ]
      }
    },
    "minimumQuality": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maxTokenIndex": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxLatencyIndex": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "complexity": {
      "type": "string",
      "enum": [
        "low",
        "standard",
        "high",
        "critical"
      ]
    },
    "allowUntrustedCapabilities": {
      "type": "boolean"
    },
    "allowUntrustedProviders": {
      "type": "boolean"
    },
    "allowInPlaceWrite": {
      "type": "boolean"
    },
    "verifierCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifierPrepareCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifierProtectedScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowChangeEvidenceOnly": {
      "type": "boolean"
    },
    "verificationIsolation": {
      "type": "string",
      "enum": [
        "same-workspace",
        "git-worktree"
      ]
    },
    "executionLane": {
      "type": "string",
      "enum": [
        "single-worker",
        "bundled",
        "orchestrated"
      ]
    },
    "laneReason": {
      "type": "string",
      "minLength": 1
    },
    "escalationSignals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambiguity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "repositoryBreadth": {
          "type": "string",
          "enum": [
            "local",
            "module",
            "wide"
          ]
        },
        "editBreadth": {
          "type": "string",
          "enum": [
            "none",
            "one-file",
            "few-files",
            "many-files"
          ]
        },
        "contextVolume": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "toolIntensity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "stateComplexity": {
          "type": "string",
          "enum": [
            "none",
            "simple",
            "complex"
          ]
        },
        "testCoverage": {
          "type": "string",
          "enum": [
            "good",
            "partial",
            "poor",
            "unknown"
          ]
        },
        "externalIntegration": {
          "type": "string",
          "enum": [
            "none",
            "read-only",
            "mutating"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "failureModes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contextFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidenceFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*\\[])(?!.*//$)(?!.*\\/$).+$"
      }
    },
    "controlPlaneChange": {
      "type": "boolean"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "proposalId"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "proposalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    }
  },
  "required": [
    "id",
    "objective",
    "kind",
    "role",
    "risk"
  ],
  "additionalProperties": true
}
